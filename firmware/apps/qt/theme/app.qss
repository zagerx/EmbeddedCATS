/* 全局样式表；@xxx 占位符由 theme.cpp 替换。 */

/* 全局只定字色与字号；背景一律由下面各区域显式指定，
 * 否则 QLabel 会被刷成实心色块，出现“灰条” */
QWidget {
	background: transparent;
	color: @fg;
	font-size: 13px;
}

/* 最底层：区域之间的留白露出这个颜色 */
#central {
	background: @deep;
}

/* ---- 1 号区域（状态）与 3 号区域（日志）：表面色 ---- */

#topArea,
#topReserved,
#logPanel {
	background: @surface;
	border: none;
}

/* ---- 2 号区域（工作区）：主背景色 ---- */

#workArea,
#reservedArea,
#axisRow,
/* 轴卡片按类名匹配：每张卡的 objectName 不同（axisCard1 / axisCard2），
 * 供绑定层区分左右轴 */
AxisCard {
	background: @bg;
	border: none;
}

/* ---- 区域内部的 1 px 分隔条 ---- */

#divider {
	background: @divider;
	border: none;
}

/* ---- 当前状态：大号等宽字 ---- */

#stateLed QLabel {
	font-size: 22px;
	font-weight: bold;
	font-family: "DejaVu Sans Mono", monospace;
	color: @fg;
}

#stateHint {
	color: @fgDim;
	font-size: 12px;
}

/* ---- 按钮 ---- */

QPushButton {
	background: @surface;
	border: 1px solid @border;
	border-radius: 4px;
	padding: 6px 14px;
}

QPushButton:hover {
	border-color: @primary;
}

QPushButton:pressed {
	background: @deep;
}

QPushButton:disabled {
	color: @fgDim;
	border-color: @border;
}

/* 2.1 区域：急停永远是红框，运动是主色框 */
#btn_estop {
	color: @fault;
	border-color: @fault;
	font-weight: bold;
}

#btn_move {
	color: @primary;
	border-color: @primary;
}

/* ---- 分组框 ---- */

QGroupBox {
	background: @surface;
	border: 1px solid @border;
	border-radius: 6px;
	margin-top: 8px;
	padding: 8px 8px 8px 8px;
}

QGroupBox::title {
	subcontrol-origin: margin;
	subcontrol-position: top left;
	left: 10px;
	padding: 0 4px;
	color: @fgDim;
}

/* ---- 输入 / 数值 ---- */

QDoubleSpinBox {
	background: @deep;
	border: 1px solid @border;
	border-radius: 4px;
	padding: 4px 6px;
	min-width: 120px;
}

QDoubleSpinBox:focus {
	border-color: @primary;
}

#value {
	color: @fg;
	font-family: "DejaVu Sans Mono", monospace;
}

#unitLabel {
	color: @fgDim;
}

#axisTitle,
#panelTitle {
	font-size: 15px;
	font-weight: bold;
	color: @fg;
}

/* ---- 日志 ---- */

#logView {
	background: @deep;
	border: 1px solid @border;
	border-radius: 4px;
	color: @fgDim;
	font-family: "DejaVu Sans Mono", monospace;
	padding: 6px;
}

/* ---- 状态栏 ---- */

QStatusBar {
	background: @surface;
	color: @fgDim;
	border-top: 1px solid @border;
}

QStatusBar QLabel {
	color: @fgDim;
	padding: 0 8px;
}
